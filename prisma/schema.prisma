generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notice {
  id          String @id @default(uuid()) 
  title       String
  content     String
  category    String
  categoryId   String 
  createdAt   DateTime? @default(now())
  categoryRelation  Category @relation(fields: [categoryId], references: [id])
  container   Container?
}

model Image {
  id          String @id @default(uuid()) 
  title       String
  imageUrl    String
  imageData   String // Base64 encoded image data
  fileName    String
  createdAt   DateTime? @default(now())
  container   ImageContainer?
}

model Container{
  id       String     @id @default(uuid())
  type     String
  height   Float
  width    Float
  top      Float
  left     Float 
  NoticeRelation Notice @relation(fields: [noticeId], references: [id])
  noticeId  String @unique
}

model ImageContainer{
  id       String     @id @default(uuid())
  type     String
  height   Float
  width    Float
  top      Float
  left     Float 
  ImageRelation Image @relation(fields: [imageId], references: [id])
  imageId  String @unique
}

model Category {
  id      String @id @default(uuid())
  name    String @unique
  notices Notice[]
  icon    String? // New: icon for the category
  editedName String? // New: editable category name
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  // noticeId
}

model Dashboard {
  id           String @id @default(uuid())
  aspectRatio  String
  containers   Json
  createdAt   DateTime? @default(now())
}

model Template {
  id             String   @id @default(cuid())
  name           String
  description    String?
  widgets        Json
  layout         Json
  widgetSettings Json
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}