generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String               @unique
  password            String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  role                UserRole             @default(USER)
  ModeratorPermission ModeratorPermission?
}

model Notice {
  id                  String     @id @default(uuid())
  category            String
  categoryId          String
  content             String
  createdAt           DateTime?  @default(now())
  title               String
  pdfData             String?
  pdfFileName         String?
  pdfUrl              String?
  imageData           String?
  imageFileName       String?
  imageUrl            String?
  displayCategoryName String?
  updatedAt           DateTime?  @updatedAt
  container           Container?
  categoryRelation    Category   @relation(fields: [categoryId], references: [id])
}

model Container {
  id             String @id @default(uuid())
  type           String
  height         Float
  width          Float
  top            Float
  left           Float
  noticeId       String @unique
  NoticeRelation Notice @relation(fields: [noticeId], references: [id])
}

model Category {
  id           String       @id @default(uuid())
  name         String
  editedName   String?
  icon         String?
  categoryType CategoryType @default(TEXT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  notices      Notice[]

  @@unique([name, categoryType])
}

model Dashboard {
  id           String    @id @default(uuid())
  aspectRatio  String
  containers   Json
  screenName   String?
  screenIndex  Int?
  totalScreens Int?
  createdAt    DateTime? @default(now())
}

model Template {
  id             String   @id @default(cuid())
  createdAt      DateTime @default(now())
  description    String?
  layout         Json
  name           String
  updatedAt      DateTime @updatedAt
  widgetSettings Json
  widgets        Json
}

model PublicNoticeSettings {
  id                      String   @id @default(cuid())
  logo                    String?
  logoFileName            String?
  title                   String   @default("Digital Notice Board")
  subtitle                String   @default("Information Technology Department")
  emergencyNumber         String   @default("01734528367")
  emergencyContact        String   @default("Md. Rashid Al Asif")
  departmentName          String   @default("Information Technology Department")
  backgroundType          String   @default("gradient")
  backgroundColor         String?
  gradientColors          Json?
  backgroundImage         String?
  backgroundImageFileName String?
  headerBackgroundColor   String   @default("#1e293b")
  footerBackgroundColor   String   @default("#1e293b")
  accentColor             String   @default("#3b82f6")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  fontColor               String   @default("#ffffff")
}

model PublicNoticeTemplate {
  id                      String   @id @default(cuid())
  name                    String
  description             String?
  logo                    String?
  logoFileName            String?
  title                   String   @default("Digital Notice Board")
  subtitle                String   @default("Information Technology Department")
  emergencyNumber         String   @default("01734528367")
  emergencyContact        String   @default("Md. Rashid Al Asif")
  departmentName          String   @default("Information Technology Department")
  backgroundType          String   @default("gradient")
  backgroundColor         String?
  gradientColors          Json?
  backgroundImage         String?
  backgroundImageFileName String?
  headerBackgroundColor   String   @default("#1e293b")
  footerBackgroundColor   String   @default("#1e293b")
  accentColor             String   @default("#3b82f6")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  fontColor               String   @default("#ffffff")
}

model Pdf {
  id        String   @id @default(cuid())
  title     String
  pdfData   String
  fileName  String
  fileSize  Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ModeratorPermission {
  id            String   @id @default(cuid())
  moderatorId   String   @unique
  allowedRoutes String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  moderator     User     @relation(fields: [moderatorId], references: [id])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  USER
}

enum CategoryType {
  TEXT
  IMAGE
  PDF
}
